# Sao chép thành .env rồi sửa giá trị:  cp .env.example .env     (KHÔNG commit file .env)

# --- Database (MariaDB) ---
DB_ROOT_PASSWORD=change-me-root
DB_USER=app
DB_PASSWORD=change-me
DB_NAME=appdb

# --- Backend ---
# Khóa ký JWT, >= 16 ký tự. BẮT BUỘC đổi khi triển khai thật (sinh nhanh: openssl rand -hex 32).
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_TTL_HOURS=24
# Origin được phép gọi API, cách nhau bởi dấu phẩy. * = tất cả (chỉ nên dùng khi dev).
CORS_ALLOWED_ORIGINS=*
RUST_LOG=info,tower_http=debug

# --- Chạy local ---
# Cổng máy bạn mở cho giao diện (http://localhost:<WEB_PORT>).
WEB_PORT=80

# --- Chạy trên server (compose.prod.yaml) ---
# APP_HOST=shop.example.com
