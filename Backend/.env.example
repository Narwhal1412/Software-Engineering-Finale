# Sao chép thành .env rồi sửa giá trị. KHÔNG commit file .env.

# Cổng backend lắng nghe. Mặc định 3000 vì vite proxy và nginx của frontend trỏ tới 3000.
APP_PORT=3000

# Khóa ký JWT (>= 16 ký tự). BẮT BUỘC đổi khi triển khai thật.
JWT_SECRET=dev-only-insecure-secret-change-me
# Thời hạn token (giờ)
JWT_TTL_HOURS=24

# Thư mục lưu ảnh upload, được phục vụ tại /uploads/...
UPLOAD_DIR=uploads

# Danh sách origin được phép gọi API, cách nhau bởi dấu phẩy. Để trống hoặc * = cho tất cả.
CORS_ALLOWED_ORIGINS=*

# Mức log (tracing EnvFilter)
RUST_LOG=info,tower_http=debug

# Thông tin kết nối MariaDB (xem docs/DATABASE_SPEC.md).
DB_HOST=localhost
DB_PORT=3306
DB_USER=app
DB_PASSWORD=change-me
DB_NAME=appdb
